// -- Enums --
available_coverage_modes: enum = {
    ATOMIC;
}

// -- Setups --
minimums_coverage_config: setup = {
    minimum: float;
    rationale?: string = "";
    description?: string = "";
}

coverage_policy_config: setup = {
    version: integer;
    coverage_mode: available_coverage_modes;
    exclude_packages: []string;
    package_minimums: mapping(string, minimums_coverage_config);
    file_minimums: mapping(string, minimums_coverage_config);
}

// -- Policy --
coverage_policy: coverage_policy_config = {
    version = 1,
    coverage_mode = .ATOMIC,
    exclude_packages = []string{
        "analysis/internal/pathpolicy",
        "analysis/internal/sqliteuri",
        "analysis/internal/textlimit",
        "analysis/tooling/go/coveragecheck",
        "analysis/tooling/go/doccheck",
        "analysis/tooling/go/something-printer",
        // Process-only entrypoints delegate to covered importable implementations.
        "analysis/backend/cmd/analysis",
        "analysis/tooling/go/cmd/coveragecheck",
        "analysis/tooling/go/cmd/doccheck",
        "analysis/tooling/go/cmd/importcheck",
        "analysis/tooling/go/cmd/pdf-store",
