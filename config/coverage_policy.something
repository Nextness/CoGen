        },
        ["analysis/backend/workspace/providercache/cache.go"] => {
            minimum = 73.0,
            rationale = "Cache policy ordering and provenance are correctness-sensitive."
        },
        ["analysis/backend/workspace/store.go"] => {
            minimum = 66.0,
