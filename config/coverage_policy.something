        ["analysis/backend/database/artifact"] => { minimum =  90.0 },
        ["analysis/backend/database/artifact/internal/sql"] => {
            minimum = 80.0,
            rationale = "Generated artifact queries are exercised through the handwritten family integration and integrity tests."
        },
        ["analysis/backend/database/audit"] => { minimum =  90.0 },
        ["analysis/backend/database/audit/internal/sql"] => {
            minimum = 80.0,
