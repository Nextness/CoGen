// Each _workspace iteration is one declared search revision.
// Running without --workspace executes every iteration in declaration order;
// Running with --workspace search_id@search_revision selects one or more exact iterations.

#include("baseline.something");

// -- Private Default values --
#priv default_contact_email := "natan.menegasse@uni9.edu.br";
#priv default_user_agent := "AcademicEnrichmentTool/1.0";

// -- Macros --
#macro make_enrichment_providers := () -> []enrichment_provider_config {
    #set [
        enrichment_provider_config {
            name = "crossref",
            base_url = "https://api.crossref.org/works/",
            user_agent = default_user_agent,
            contact_email = default_contact_email,
            fields = []string { "title", "authors", "publisher", "references" },
        },
        enrichment_provider_config {
            name = "openalex",
            base_url = "https://api.openalex.org/works/",
            user_agent = default_user_agent,
            contact_email = default_contact_email,
            fields = []string { "title", "abstract", "authors", "publisher", "references", "citation_count", "reference_count" },
            extra_urls = mapping(string, string) {
                ["author"] => "https://api.openalex.org/authors/"
            },
            fill_missing_only = false,
        },
        enrichment_provider_config {
            name = "orcid",
            base_url = "https://pub.orcid.org/v3.0/",
            user_agent = default_user_agent,
            contact_email = default_contact_email,
            fields = []string { "orcid", "display_name", "institution", "works_count", "cited_by_count", "h_index", "i10_index" },
            extra_urls = mapping(string, string) {
                ["search"] => "https://pub.orcid.org/v3.0/search"
            },
        },
    ];
}

#macro make_cache_policy := () -> cache_policy_config {
    #set cache_policy_config {
        reads = []cache_policy_read_options {
            .GLOBAL, .NETWORK
        },
        writes = []cache_policy_write_options {
            .ACTIVE_RUN, .GLOBAL
        },
        negative_ttl_days = 14,
    };
}

#macro make_requested_fields := () -> []string {
    #set []string { "title", "doi", "authors", "references" };
}

#macro make_keep_fields := () -> []string {
    #set []string {
        "doi", "title", "authors", "year", "keywords", "keywords_additional",
        "abstract", "source", "publisher", "journal", "affiliations",
        "cited_references", "citation_count",
    };
}

#macro string_to_ieeexplore_search_term := (input: string, delimiter: string, enrich: string, second_delimiter: string) -> string {
    split_result := @split_by(input, delimiter);
    enrich_result := @append_prefix_for_each(split_result, enrich);
    result := @concat(enrich_result, second_delimiter);
    #set result;
}

// -- Scopes --
#iteration("_workspace"): scope = {
    #priv component_1  := '"BPMN" OR "BPMN 2.0" OR "Business Process Model and Notation"';
    #priv component_2A := '"scheduling" OR "resource allocation" OR "resource assignment" OR "makespan" OR "workflow scheduling" OR "task scheduling"';
    #priv component_2B := '"genetic algorithm" OR "particle swarm" OR "ant colony" OR "simulated annealing" OR "MILP" OR "mixed integer" OR "constraint programming" OR "metaheuristic"';
    #priv component_2C := '"optimization" OR "BPO" OR "business process optimization" OR "multi-objective" OR "QoS" OR "quality of service" OR "cost optimization" OR "throughput" OR "cycle time"';
    #priv component_2D := '"formal semantics" OR "formal model" OR "formalization" OR "Petri net" OR "workflow net" OR "soundness" OR "process algebra" OR "verification" OR "model checking" OR "state space" OR "mathematical model" OR "MILP" OR "constraint programming"';

    workspace: workspace_config = {
        format_version = 2,
        search_id = "bpmn-optimisation",
        search_revision = "2026-07-query-expansion",
        enrichment_enabled = true,
        reuse_policy = reuse_policy_config {
            policy = "reuse_completed",
        },
        cache_policy = make_cache_policy!(),
        sources = [
            {
                name = "scopus",
                date = "2026-06-07 22:18:00",
                expected_file = "../corpus/scopus.raw.csv",
                file_type = "csv",
                query = #multiline (no_indent|no_newline) SCOPUS
                    TITLE-ABS-KEY(({component_1}) AND ({component_2A} OR {component_2B} OR {component_2C} OR {component_2D}))
                SCOPUS,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 1260 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  627 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  187 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  185 },
                },
                expected_result_count = 185,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["author keywords"] => "keywords",
                    ["index keywords"] => "keywords_additional",
                    ["source title"] => "journal",
                    ["references"] => "cited_references",
                    ["cited by"] => "citation_count",
                    ["article_source"] => "source",
                },
                keep_fields = make_keep_fields!(),
            },
            {
                name = "wos",
                date = "2026-06-07 22:22:00",
                expected_file = "../corpus/wos.raw.bib",
                file_type = "bib",
                query = #multiline (no_indent|no_newline|strip_spaces) WOS
                    TS=({component_1}) AND
                    TS=({component_2A} OR {component_2B} OR {component_2C} OR {component_2D})
                WOS,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 579 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  360 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  176 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  172 },
                },
                expected_result_count = 172,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["cited-references"] => "cited_references",
                    ["author"] => "authors",
                    ["affiliation"] => "affiliations",
                    ["article_source"] => "source",
                    ["keywords-plus"] => "keywords_additional",
                    ["times-cited"] => "citation_count",
                },
                keep_fields = make_keep_fields!(),
            },
            {
                name = "ieeexplore",
                date = "2026-06-07 22:26:00",
                expected_file = "../corpus/ieeexplore.raw.csv",
                file_type = "csv",
                query = #multiline (no_indent|no_newline|strip_spaces) IEEEXPLORE
                    ("Document Title": ({component_1}) AND ({component_2A} OR {component_2B} OR {component_2C} OR {component_2D}))
                    OR ("documentAbstract": ({component_1}) AND ({component_2A} OR {component_2B} OR {component_2C} OR {component_2D}))
                    OR ("authorTerms": ({component_1}) AND ({component_2A} OR {component_2B} OR {component_2C} OR {component_2D}))
                IEEEXPLORE,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 921 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  462 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  45 },
                    // IEEEXplore doesn't have a filter for english, since they only accept english papers.
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  45 },
                },
                expected_result_count = 45,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["document title"] => "title",
                    ["publication year"] => "year",
                    ["author keywords"] => "keywords",
                    ["ieee terms"] => "keywords_additional",
                    ["publication title"] => "journal",
                    ["author affiliations"] => "affiliations",
                    ["article citation count"] => "citation_count",
                    ["article_source"] => "source",
                },
                keep_fields = make_keep_fields!(),
            },
        ],
        enrichment_providers = make_enrichment_providers!(),
    };
}

#iteration("_workspace"): scope = {
    // I don't use any wildcards because one of the bases selected is IEEEXplore,
    // which only allows 10 wildcards. This is annoying, therefore, for the research
    // term, I've decided to use only words for the search term. No expressions and
    // weird operators, because I'm searching in several databases and each database
    // has their own way of doing things...

    #priv component_1 := #multiline (no_indent|no_newline|strip_spaces) COMP1
        // The acronym is the shortest portable identifier and already matches
        // versioned forms such as "BPMN 2.0", so those forms are not repeated.
        BPMN

        // The current official expansion captures records that spell out the
        // notation name without using the BPMN acronym.
        OR "Business Process Model and Notation"

        // The former American- and British-English names occur in literature
        // about BPMN 1.x and remain distinct literal phrases across databases.
        OR "Business Process Modeling Notation"
        OR "Business Process Modelling Notation"
    COMP1;

    #priv component_2 := #multiline (no_indent|no_newline|strip_spaces) COMP2
        // Captures the exact word shared by formal models, specifications,
        // languages, representations, analyses, and methods without repeating
        // every longer phrase that necessarily contains it.
        formal

        // Covers formal, operational, execution, process, behavioral, and
        // other semantics without enumerating redundant qualified phrases.
        OR semantics

        // American- and British-English nouns for assigning a precise
        // mathematical meaning to BPMN. They are different literal tokens.
        OR formalization
        OR formalisation

        // Captures papers that call their target representation a formalism.
        // Both number forms are explicit because IEEE Xplore may distinguish them.
        OR formalism
        OR formalisms

        // Broad mathematical wording recovers previously unknown mathematical
        // representations without predicting the target formalism in advance.
        OR mathematical

        // Captures algebraic semantics and representations beyond the named
        // process-algebra and process-calculus families in component_3.
        OR algebraic

        // The noun and adjective cover logical formalisms and logical models.
        // They are separate literal words and are not treated as interchangeable.
        OR logic
        OR logical
    COMP2;

    #priv component_3 := #multiline (no_indent|no_newline|strip_spaces) COMP3
        // Petri is distinctive in this domain and covers Petri net/nets plus
        // timed, stochastic, coloured, recursive, and other Petri-net variants.
        Petri

        // Workflow nets may be named without the word Petri. Singular and
        // plural phrases are explicit for consistent IEEE Xplore retrieval.
        OR "workflow net"
        OR "workflow nets"

        // Process algebras and calculi model concurrency, communication,
        // choice, and synchronization. The irregular plural is also explicit.
        OR "process algebra"
        OR "process algebras"
        OR "process calculus"
        OR "process calculi"

        // Graph transformations, rewriting, and grammars define BPMN
        // structure or execution through mathematically specified graph rules.
        OR "graph transformation"
        OR "graph transformations"
        OR "graph rewriting"
        OR "graph grammar"
        OR "graph grammars"

        // Process and control-flow graphs capture direct graph-based
        // representations without adding the optimization-oriented task graph.
        OR "process graph"
        OR "process graphs"
        OR "control flow graph"
        OR "control flow graphs"

        // Transition systems, state machines, state spaces, and automata cover
        // state-based semantics. Short forms also match qualified variants such
        // as labelled transition systems and abstract state machines.
        OR "transition system"
        OR "transition systems"
        OR "state machine"
        OR "state machines"
        OR "state space"
        OR "state spaces"
        OR automaton
        OR automata

        // Situation Calculus, Event-B, and Z are distinct logical or
        // set-theoretic targets used to translate or specify BPMN models.
        OR "Situation Calculus"
        OR "Event-B"
        OR "Z notation"

        // Queueing has two established spellings and covers both models and
        // networks without repeating those suffixes. Markov similarly covers
        // models and chains, while probabilistic and stochastic retain unknown
        // quantitative representations without introducing optimization terms.
        OR queueing
        OR queuing
        OR Markov
        OR probabilistic
        OR stochastic
    COMP3;

    // Furthermore, IEEEXplore is a pain in the ass and needs a very specific type of search term.
    // This is to allow the search to actually work. I don't know why they have such a pain in the
    // ass search engine...
    ieeexplore_bs_component_1 := string_to_ieeexplore_search_term!(component_1, " OR ", '"All Metadata":', " OR ");
    ieeexplore_bs_component_2 := string_to_ieeexplore_search_term!(component_2, " OR ", '"All Metadata":', " OR ");
    ieeexplore_bs_component_3 := string_to_ieeexplore_search_term!(component_3, " OR ", '"All Metadata":', " OR ");

    workspace: workspace_config = {
        format_version = 2,
        search_id = "bpmn-optimization-improved",
        search_revision = "2026-08",
        enrichment_enabled = true,
        reuse_policy = reuse_policy_config {
            policy = "reuse_completed",
        },
        cache_policy = make_cache_policy!(),
        sources = [
            {
                name = "scopus",
                date = "2026-08-23 01:37:15",
                expected_file = "../corpus/scopus.2026-08-23.raw.csv",
                file_type = "csv",
                query = #multiline (no_indent|no_newline) SCOPUS
                    TITLE-ABS-KEY(({component_1}) AND ({component_2} OR {component_3})
                SCOPUS,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 1657 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  836 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  225 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  214 },
                },
                expected_result_count = 214,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["author keywords"] => "keywords",
                    ["index keywords"] => "keywords_additional",
                    ["source title"] => "journal",
                    ["references"] => "cited_references",
                    ["cited by"] => "citation_count",
                    ["article_source"] => "source",
                },
                keep_fields = make_keep_fields!(),
            },
            {
                name = "wos",
                date = "2026-08-23 01:39:27",
                expected_file = "../corpus/wos.2026-08-23.raw.bib",
                file_type = "bib",
                query = #multiline (no_indent|no_newline|strip_spaces) WOS
                    TS=(({component_1}) AND ({component_2} OR {component_3}))
                WOS,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 895 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  471 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  211 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  208 },
                },
                expected_result_count = 208,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["cited-references"] => "cited_references",
                    ["author"] => "authors",
                    ["affiliation"] => "affiliations",
                    ["article_source"] => "source",
                    ["keywords-plus"] => "keywords_additional",
                    ["times-cited"] => "citation_count",
                },
                keep_fields = make_keep_fields!(),
            },
            {
                name = "ieeexplore",
                date = "2026-08-23 02:52:38",
                expected_file = "../corpus/ieeexplore.2026-08-23.raw.csv",
                file_type = "csv",
                query = #multiline (no_indent|no_newline|strip_spaces) IEEEXPLORE
                    {ieeexplore_bs_component_1} AND ({ieeexplore_bs_component_2} OR {ieeexplore_bs_component_3})
                IEEEXPLORE,
                filters = []raw_data_filters{
                    { filters = [.NO_FILTER], count = 958 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS], count =  483 },
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY], count =  52 },
                    // IEEEXplore doesn't have a filter for english, since they only accept english papers.
                    { filters = [.NO_FILTER, .RANGE_10_YEARS, .ARTICLE_ONLY, .ENGLISH_ONLY], count =  52 },
                },
                expected_result_count = 52,
                requested_fields = make_requested_fields!(),
                patch_fields = mapping(string, string) {
                    ["document title"] => "title",
                    ["publication year"] => "year",
                    ["author keywords"] => "keywords",
                    ["ieee terms"] => "keywords_additional",
                    ["publication title"] => "journal",
                    ["author affiliations"] => "affiliations",
                    ["article citation count"] => "citation_count",
                    ["article_source"] => "source",
                },
                keep_fields = make_keep_fields!(),
            },
        ],
        enrichment_providers = make_enrichment_providers!(),
    };
}
