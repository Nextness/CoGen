{
  "name": "research-analysis-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:unit": "node --import ./scripts/tsx-loader.ts --test \"tests/unit/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "generate:classes": "node scripts/generate-classes.ts",
    "check:classes": "node scripts/generate-classes.ts --check && node scripts/check-classes.ts",
    "rewrite:classes": "node scripts/rewrite-class-names.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "codegen": "playwright codegen http://localhost:8080",
    "build": "node scripts/build.ts",
    "build:graph-vendor": "esbuild scripts/graph-vendor.entry.ts --bundle --format=esm --target=es2022 --minify --outfile=./vendor/d3-force.js",
    "build:pdfjs-vendor": "node scripts/pdfjs-vendor.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.2.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.0.0",
    "pdfjs-dist": "4.2.67",
    "typescript": "^5.9.3"
  }
}
