{
  "name": "@cogen/tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node frontend/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:classes": "node frontend/generate-classes.ts",
    "check:classes": "node frontend/generate-classes.ts --check && node frontend/check-classes.ts",
    "rewrite:classes": "node frontend/rewrite-class-names.ts",
    "build:graph-vendor": "esbuild frontend/graph-vendor.entry.ts --bundle --format=esm --target=es2022 --minify --outfile=../../frontend/vendor/d3-force.js",
    "build:pdfjs-vendor": "node frontend/pdfjs-vendor.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "d3-force": "^3.0.0",
    "pdfjs-dist": "4.2.67"
  }
}
